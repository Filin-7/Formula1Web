@{
    ViewData["Title"] = "Formula 1";
}

<!-- Головний банер -->
<header class="masthead">
    <div class="container">

        <div class="masthead-subheading">
            Welcome to Formula 1!
        </div>

        <div class="masthead-heading text-uppercase">
            The world of racing
        </div>

        <a class="btn btn-primary btn-xl text-uppercase"
           href="#services">
            Tell me more
        </a>

    </div>
</header>


<!-- Розділ Formula 1 -->
<section class="page-section" id="services">
    <div class="container">

        <div class="text-center">
            <h2 class="section-heading text-uppercase">
                Formula 1
            </h2>

            <h3 class="section-subheading text-muted">
                Welcome to the world of Formula 1
            </h3>
        </div>

        <div class="row text-center">

            <!-- Racing -->
            <div class="col-md-4">

                <span class="fa-stack fa-4x">
                    <i class="fas fa-circle fa-stack-2x text-primary"></i>
                    <i class="fas fa-flag-checkered fa-stack-1x fa-inverse"></i>
                </span>

                <h4 class="my-3">Racing</h4>

                <p class="text-muted">
                    The most exciting races in the world.
                </p>

            </div>

            <!-- Teams -->
            <div class="col-md-4">

                <span class="fa-stack fa-4x">
                    <i class="fas fa-circle fa-stack-2x text-primary"></i>
                    <i class="fas fa-car fa-stack-1x fa-inverse"></i>
                </span>

                <h4 class="my-3">Teams</h4>

                <p class="text-muted">
                    Information about Formula 1 teams.
                </p>

            </div>

            <!-- Champions -->
            <div class="col-md-4">

                <span class="fa-stack fa-4x">
                    <i class="fas fa-circle fa-stack-2x text-primary"></i>
                    <i class="fas fa-trophy fa-stack-1x fa-inverse"></i>
                </span>

                <h4 class="my-3">Champions</h4>

                <p class="text-muted">
                    The greatest Formula 1 champions.
                </p>

            </div>

        </div>
    </div>
</section>


<!-- Розділ File Manager -->
<section class="page-section bg-light" id="files">
    <div class="container">

        <div class="text-center">

            <h2 class="section-heading text-uppercase">
                File Manager
            </h2>

            <h3 class="section-subheading text-muted">
                Upload and view your files
            </h3>

        </div>

        <div class="row text-center">

            <div class="col-md-6 mb-4">

                <span class="fa-stack fa-4x">
                    <i class="fas fa-circle fa-stack-2x text-primary"></i>
                    <i class="fas fa-cloud-upload-alt fa-stack-1x fa-inverse"></i>
                </span>

                <h4 class="my-3">Upload Files</h4>

                <p class="text-muted">
                    Upload images, PDF and text files to the server.
                </p>

                <a asp-controller="Files"
                   asp-action="Upload"
                   class="btn btn-primary btn-xl text-uppercase">
                    Upload Files
                </a>

            </div>

            <div class="col-md-6 mb-4">

                <span class="fa-stack fa-4x">
                    <i class="fas fa-circle fa-stack-2x text-primary"></i>
                    <i class="fas fa-folder-open fa-stack-1x fa-inverse"></i>
                </span>

                <h4 class="my-3">View Files</h4>

                <p class="text-muted">
                    View all uploaded files and open them.
                </p>

                <a asp-controller="Files"
                   asp-action="Index"
                   class="btn btn-success btn-xl text-uppercase">
                    View Files
                </a>

            </div>

        </div>

    </div>
</section>


<!-- Розділ Contact us -->
<section class="page-section" id="contact">
    <div class="container">

        @if (ViewBag.Message != null)
        {
            <div class="alert alert-success text-center">
                @ViewBag.Message
            </div>
        }

        <div class="text-center">

            <h2 class="section-heading text-uppercase">
                Contact us
            </h2>

            <h3 class="section-subheading text-muted">
                Send us a message
            </h3>

        </div>

        <form asp-controller="Home"
              asp-action="SendEmail"
              method="post">

            @Html.AntiForgeryToken()

            <div class="row">

                <div class="col-md-6 mb-3">

                    <label for="Email" class="form-label">
                        Email
                    </label>

                    <input type="email"
                           class="form-control"
                           id="Email"
                           name="Email"
                           placeholder="Your email"
                           required />

                </div>

                <div class="col-md-6 mb-3">

                    <label for="Message" class="form-label">
                        Message
                    </label>

                    <textarea class="form-control"
                              id="Message"
                              name="Message"
                              rows="5"
                              placeholder="Your message"
                              required></textarea>

                </div>

            </div>

            <div class="text-center">

                <button type="submit"
                        class="btn btn-primary btn-xl text-uppercase">
                    Submit
                </button>

            </div>

        </form>

    </div>
</section>
