@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Formula1Web.SharedResource> L

@{
    ViewData["Title"] = "Formula 1";
}

<!-- Головний банер -->
<header class="masthead">
    <div class="container">

        <div class="masthead-subheading">
            @L["Welcome"]
        </div>

        <div class="masthead-heading text-uppercase">
            @L["MainTitle"]
        </div>

        <a class="btn btn-primary btn-xl text-uppercase"
           href="#services">
            @L["TellMore"]
        </a>

    </div>
</header>


<!-- Розділ Formula 1 -->
<section class="page-section" id="services">
    <div class="container">

        <div class="text-center">

            <h2 class="section-heading text-uppercase">
                @L["FormulaTitle"]
            </h2>

            <h3 class="section-subheading text-muted">
                @L["FormulaDescription"]
            </h3>

        </div>

        <div class="row text-center">

            <!-- Racing -->
            <div class="col-md-4">

                <span class="fa-stack fa-4x">
                    <i class="fas fa-circle fa-stack-2x text-primary"></i>
                    <i class="fas fa-flag-checkered fa-stack-1x fa-inverse"></i>
                </span>

                <h4 class="my-3">@L["Racing"]</h4>

                <p class="text-muted">
                    @L["RacingDescription"]
                </p>

            </div>

            <!-- Teams -->
            <div class="col-md-4">

                <span class="fa-stack fa-4x">
                    <i class="fas fa-circle fa-stack-2x text-primary"></i>
                    <i class="fas fa-car fa-stack-1x fa-inverse"></i>
                </span>

                <h4 class="my-3">@L["Teams"]</h4>

                <p class="text-muted">
                    @L["TeamsDescription"]
                </p>

            </div>

            <!-- Champions -->
            <div class="col-md-4">

                <span class="fa-stack fa-4x">
                    <i class="fas fa-circle fa-stack-2x text-primary"></i>
                    <i class="fas fa-trophy fa-stack-1x fa-inverse"></i>
                </span>

                <h4 class="my-3">@L["Champions"]</h4>

                <p class="text-muted">
                    @L["ChampionsDescription"]
                </p>

            </div>

        </div>
    </div>
</section>


<!-- Розділ File Manager -->
<section class="page-section bg-light" id="files">
    <div class="container">

        <div class="text-center">

            <h2 class="section-heading text-uppercase">
                @L["FileManager"]
            </h2>

            <h3 class="section-subheading text-muted">
                @L["FileDescription"]
            </h3>

        </div>

        <div class="row text-center">

            <!-- Upload Files -->
            <div class="col-md-6 mb-4">

                <span class="fa-stack fa-4x">
                    <i class="fas fa-circle fa-stack-2x text-primary"></i>
                    <i class="fas fa-cloud-upload-alt fa-stack-1x fa-inverse"></i>
                </span>

                <h4 class="my-3">
                    @L["UploadFiles"]
                </h4>

                <p class="text-muted">
                    @L["FileDescription"]
                </p>

                <a asp-controller="Files"
                   asp-action="Upload"
                   class="btn btn-primary btn-xl text-uppercase">
                    @L["UploadFiles"]
                </a>

            </div>

            <!-- View Files -->
            <div class="col-md-6 mb-4">

                <span class="fa-stack fa-4x">
                    <i class="fas fa-circle fa-stack-2x text-primary"></i>
                    <i class="fas fa-folder-open fa-stack-1x fa-inverse"></i>
                </span>

                <h4 class="my-3">
                    @L["ViewFiles"]
                </h4>

                <p class="text-muted">
                    @L["FileDescription"]
                </p>

                <a asp-controller="Files"
                   asp-action="Index"
                   class="btn btn-success btn-xl text-uppercase">
                    @L["ViewFiles"]
                </a>

            </div>

        </div>

    </div>
</section>


<!-- Розділ Contact us -->
<section class="page-section" id="contact">
    <div class="container">

        @if (ViewBag.Message != null)
        {
            <div class="alert alert-success text-center">
                @ViewBag.Message
            </div>
        }

        <div class="text-center">

            <h2 class="section-heading text-uppercase">
                @L["ContactUs"]
            </h2>

            <h3 class="section-subheading text-muted">
                @L["ContactDescription"]
            </h3>

        </div>

        <form asp-controller="Home"
              asp-action="SendEmail"
              method="post">

            @Html.AntiForgeryToken()

            <div class="row">

                <div class="col-md-6 mb-3">

                    <label for="Email" class="form-label">
                        @L["Email"]
                    </label>

                    <input type="email"
                           class="form-control"
                           id="Email"
                           name="Email"
                           placeholder="@L["Email"]"
                           required />

                </div>

                <div class="col-md-6 mb-3">

                    <label for="Message" class="form-label">
                        @L["Message"]
                    </label>

                    <textarea class="form-control"
                              id="Message"
                              name="Message"
                              rows="5"
                              placeholder="@L["Message"]"
                              required></textarea>

                </div>

            </div>

            <div class="text-center">

                <button type="submit"
                        class="btn btn-primary btn-xl text-uppercase">
                    @L["Submit"]
                </button>

            </div>

        </form>

    </div>
</section>
