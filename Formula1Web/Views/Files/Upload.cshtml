@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Formula1Web.SharedResource> L

@{
    ViewData["Title"] = L["UploadFiles"].Value;
}

<section class="page-section">
    <div class="container">

        <h2 class="text-center mb-4">
            @L["UploadFiles"]
        </h2>

        <form asp-controller="Files"
              asp-action="Upload"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label class="form-label">
                    @L["SelectFile"]
                </label>

                <input type="file"
                       name="file"
                       class="form-control"
                       accept=".jpg,.jpeg,.png,.gif,.pdf,.txt"
                       required />
            </div>

            <button type="submit"
                    class="btn btn-primary">
                @L["Upload"]
            </button>

            <a asp-controller="Files"
               asp-action="Index"
               class="btn btn-secondary">
                @L["ViewFiles"]
            </a>

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Home
            </a>

        </form>

    </div>
</section>
