@model List<string>
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Formula1Web.SharedResource> L

@{
    ViewData["Title"] = L["UploadedFiles"].Value;
}

<section class="page-section">
    <div class="container">

        <h2 class="text-center mb-4">
            @L["UploadedFiles"]
        </h2>

        <div class="mb-4">

            <a asp-controller="Files"
               asp-action="Upload"
               class="btn btn-primary">
                @L["UploadNewFile"]
            </a>

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-secondary">
                Home
            </a>

        </div>

        @if (Model == null || Model.Count == 0)
        {
            <div class="alert alert-info">
                @L["NoFiles"]
            </div>
        }
        else
        {
            <table class="table table-bordered table-striped">

                <thead>
                    <tr>
                        <th>@L["FileName"]</th>
                        <th>@L["Action"]</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var file in Model)
                    {
                        <tr>
                            <td>@file</td>

                            <td>
                                <a asp-controller="Files"
                                   asp-action="ViewFile"
                                   asp-route-fileName="@file"
                                   target="_blank"
                                   rel="noopener"
                                   class="btn btn-success btn-sm">
                                    @L["ViewFile"]
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        }

    </div>
</section>
