
@using System.Globalization

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Formula 1</title>

    <!-- Favicon -->
    <link rel="icon"
          type="image/x-icon"
          href="~/assets/favicon.ico" />

    <!-- Font Awesome -->
    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js"
            crossorigin="anonymous"></script>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Montserrat:400,700"
          rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css?family=Roboto+Slab:400,100,300,700"
          rel="stylesheet" />

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/css/bootstrap.min.css"
          asp-append-version="true" />

    <!-- Основні стилі сайту -->
    <link rel="stylesheet"
          href="~/css/styles.css"
          asp-append-version="true" />

    <!-- Додаткові стилі -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <style>
        /* Кнопка відкриття Sidebar */
        .sidebar-toggle {
            position: fixed;
            top: 90px;
            left: 15px;
            z-index: 1040;
            border-radius: 8px;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.2);
        }

        /* Висувне меню */
        .offcanvas {
            max-width: 320px;
        }

        .offcanvas-header {
            background-color: #212529;
            color: white;
        }

        .offcanvas-body {
            background-color: #f8f9fa;
        }
    </style>

</head>

<body id="page-top">

    <!-- Navbar ViewComponent -->
    @await Component.InvokeAsync("Navbar")

    <!-- Перемикач мов -->
    <div class="container">
        <partial name="_LanguageSwitcher" />
    </div>

    <!-- Кнопка відкриття Sidebar -->
    <button class="btn btn-warning sidebar-toggle"
            type="button"
            data-bs-toggle="offcanvas"
            data-bs-target="#sidebarMenu"
            aria-controls="sidebarMenu"
            aria-label="Open menu">
        ☰ Menu
    </button>

    <!-- Висувне бокове меню -->
    <div class="offcanvas offcanvas-start"
         tabindex="-1"
         id="sidebarMenu"
         aria-labelledby="sidebarMenuLabel">

        <div class="offcanvas-header">

            <h5 class="offcanvas-title"
                id="sidebarMenuLabel">
                Formula 1 Menu
            </h5>

            <button type="button"
                    class="btn-close btn-close-white"
                    data-bs-dismiss="offcanvas"
                    aria-label="Close">
            </button>

        </div>

        <div class="offcanvas-body">

            <!-- Sidebar ViewComponent -->
            @await Component.InvokeAsync(
                "Sidebar",
                new { layout = "Main" })

        </div>

    </div>

    <!-- Основний вміст сторінки -->
    <main>
        @RenderBody()
    </main>

    <!-- Bootstrap JavaScript -->
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"
            asp-append-version="true"></script>

    <!-- Скрипти сайту -->
    <script src="~/js/scripts.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
